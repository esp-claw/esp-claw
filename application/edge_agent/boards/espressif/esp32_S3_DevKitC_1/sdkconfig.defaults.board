
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# No display, camera or BLE on this board.
CONFIG_APP_CLAW_LUA_MODULE_LCD=n
CONFIG_APP_CLAW_LUA_MODULE_DISPLAY=n
CONFIG_APP_CLAW_LUA_MODULE_LVGL=n
CONFIG_APP_CLAW_LUA_MODULE_IMAGE=n
CONFIG_BT_ENABLED=n
# Two OTA slots, skills/scripts embedded in the app, rollback to the previous image on failure.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8MB_ota.csv"
CONFIG_EDGE_AGENT_SYSTEM_FS_EMBEDDED=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
